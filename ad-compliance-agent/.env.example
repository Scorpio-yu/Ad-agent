# ===== LLM 配置（OpenAI 兼容接口，默认 DeepSeek）=====
# 支持 OpenAI / DeepSeek / Qwen / 智谱 等
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1

# ===== Embedding 配置 =====
# 模式：api（在线，无需下载模型）或 local（本地，不需联网）
EMBEDDING_PROVIDER=api

# 在线 API 模式（推荐，推荐 SiliconFlow，siliconflow.cn 免费注册）
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-your-siliconflow-key

# 本地模型模式（如需离线使用，取消下面注释，并注释上面的 api 行）：
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=shibing624/text2vec-base-chinese
# EMBEDDING_DEVICE=cpu
# HF_ENDPOINT=https://hf-mirror.com     # 国内 HuggingFace 镜像
# HF_HUB_OFFLINE=1                       # 模型已缓存则设为 1（禁止联网校验）
# TRANSFORMERS_OFFLINE=1

# ===== Chroma 配置 =====
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=ad_regulations

# ===== 检索配置 =====
RETRIEVER_TOP_K=5
